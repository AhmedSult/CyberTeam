# ============================================================================
# Streamlit Secrets — قالب
# ----------------------------------------------------------------------------
# الخطوات:
# 1) انسخ هذا الملف:
#       cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# 2) ضع مفتاحك الحقيقي في .streamlit/secrets.toml
#    (هذا الملف الجديد محمي بـ .gitignore ولن يُرفع لـ Git)
# 3) شغّل التطبيق:
#       streamlit run streamlit_app.py
# 4) للنشر على Streamlit Cloud:
#    افتح التطبيق → Settings → Secrets → الصق نفس المحتوى.
# ============================================================================

OPENAI_API_KEY = "sk-proj-REPLACE_WITH_YOUR_KEY"
OPENAI_MODEL = "gpt-4o-mini"
# AI_SA_CYBER_CONTEXT_EXTRA = "سياسات/سياق إضافي اختياري"
